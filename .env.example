# Copy to .env, then run docker compose up -d.
# The container generates and persists private database credentials and keys.
APP_PORT=8080
AUTH_PUBLIC_ORIGIN=http://localhost:8080
AUTH_COOKIE_SECURE=false

# For public HTTPS deployment, set the exact HTTPS origin above and Secure=true.
# The default Compose port is loopback-only; use your HTTPS ingress for remote access.
# Optional immutable image/alternate data volume selectors:
# ELSE_IMAGE=ghcr.io/theroisey/else:sha-<full-commit>
# ELSE_DATA_VOLUME=roisey-else_postgres-data
