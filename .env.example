# Local installation: cp .env.example .env && make up
APP_PORT=8080
AUTH_PUBLIC_ORIGIN=http://localhost:8080
AUTH_COOKIE_SECURE=false

# Public deployment: set the exact HTTPS origin and AUTH_COOKIE_SECURE=true.
# The published port remains on loopback; use your managed HTTPS ingress.
# Retain the complete data volume and verified backups, including retained keys.

# Passwordless sign-in requires a verified sending domain and working SMTP.
# No SMTP credentials are shipped. Configure these before upgrading live traffic.
SMTP_HOST=
# Blank authentication mode preserves credentials; trusted_relay is explicit only.
SMTP_AUTH_MODE=
SMTP_RELAY_IP=
SMTP_PORT=
SMTP_USERNAME=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_SECURITY=
SMTP_TIMEOUT_SECONDS=
# Prefer a protected mounted secret and SMTP_PASSWORD_FILE in the container.
# See notes/authentication.md and docker-compose.smtp.example.yml.
# A fully blank SMTP configuration leaves new sign-ins unavailable (existing sessions work).
AUTH_OTP_LIFETIME_SECONDS=180
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_EMAIL_REQUESTS=3
AUTH_OTP_PEER_REQUESTS=30
AUTH_OTP_GLOBAL_REQUESTS=300
