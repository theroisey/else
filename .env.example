# Local installation: cp .env.example .env && make up
APP_PORT=8080
AUTH_PUBLIC_ORIGIN=http://localhost:8080
AUTH_COOKIE_SECURE=false

# Public deployment requires the exact HTTPS origin and AUTH_COOKIE_SECURE=true.
# The published port stays on loopback; terminate HTTPS at your hosting ingress.
# ELSE_IMAGE=ghcr.io/theroisey/else@sha256:<verified-digest>
# ELSE_DATA_VOLUME=roisey-else_postgres-data

# Optional report cache: uncomment BOTH lines. Redis loss never loses durable data.
# COMPOSE_PROFILES=cache
# REDIS_URL=redis://redis:6379/0

# Keys are generated privately within the persistent volume. Retain the full
# volume/backup bundle, including .control/integration-keyring.json.
